{
    "compilerOptions": {
        "target": "es2024",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["ESNext"],
        "declaration": true,
        "sourceMap": true,
        "composite": true,
        "strict": true,
        "skipLibCheck": true,
        "incremental": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    }
}