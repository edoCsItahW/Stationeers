# 端到端内联提示测试夹具：每一行对应一条伪代码，改动会破坏测试
# End-to-end inlay hint fixture: one line per pseudocode case; changing it breaks the tests
# （用例见 packages/client/src/test/suite/inlayHint.test.ts）

alias a r1

alias heater d1

add a a 1

lb r0 HASH("StructureBatteryMedium") Setting Average

s heater On r6

l r3 heater Setting

ls r4 heater 1 Charge

ss heater 1 Charge r8

sqrt r7 9

snan r9 r8

beq a 10 5

brlt a 10 3

j 20

# 以下都不该出提示：注释、alias / define 预处理指令，以及没写完的指令（缺第三个操作数）
# No hint below: comments, alias / define directives, and an incomplete instruction (its third operand missing)
define limit 10

add r5 r6
