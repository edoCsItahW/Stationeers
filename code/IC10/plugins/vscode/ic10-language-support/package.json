{
    "name": "ic10",
    "displayName": "IC10",
    "description": "%ic10.description%",
    "author": "edocsitahw",
    "license": "CC BY-NC-SA 4.0",
    "version": "2.1.0",
    "publisher": "edocsitahw",
    "repository": {
        "type": "git",
        "url": "https://github.com/edoCsItahW/Stationeers.git"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "Stationeers",
        "IC10"
    ],
    "engines": {
        "vscode": "^1.125.0"
    },
    "activationEvents": [],
    "main": "./packages/client/dist/extension.js",
    "icon": "icon.png",
    "screenshots": [
        "static/completion.mp4",
        "static/diagnostic.png",
        "static/formatting.png",
        "static/grammar.png",
        "static/hover.mp4",
        "static/locale.png",
        "static/semantic.png",
        "static/signature.mp4"
    ],
    "contributes": {
        "languages": [
            {
                "id": "ic10",
                "aliases": [
                    "IC10",
                    "ic10"
                ],
                "extensions": [
                    ".ic",
                    ".ic10"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "ic10",
                "scopeName": "source.ic10",
                "path": "./syntaxes/ic10.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "%ic10.configuration.title%",
            "properties": {
                "ic10.language": {
                    "enum": [
                        "en-us",
                        "zh-hans"
                    ],
                    "enumDescriptions": [
                        "English(Default, US)",
                        "简体中文"
                    ],
                    "default": "en-us",
                    "description": "%ic10.configuration.language.description%"
                },
                "ic10.hoverRenderer": {
                    "enum": [
                        "svg",
                        "markdown"
                    ],
                    "enumDescriptions": [
                        "SVG",
                        "Markdown"
                    ],
                    "default": "svg",
                    "description": "%ic10.configuration.hoverRenderer.description%"
                },
                "ic10.format.useTab": {
                    "type": "boolean",
                    "default": false,
                    "description": "%ic10.configuration.format.useTab.description%"
                },
                "ic10.format.indentWidth": {
                    "type": "number",
                    "default": 4,
                    "description": "%ic10.configuration.format.indentWidth.description%"
                },
                "ic10.format.spacesBeforeTrailingComments": {
                    "type": "number",
                    "default": 2,
                    "description": "%ic10.configuration.format.spacesBeforeTrailingComments.description%"
                },
                "ic10.format.maxEmptyLinesToKeep": {
                    "type": "number",
                    "default": 1,
                    "description": "%ic10.configuration.format.maxEmptyLinesToKeep.description%"
                },
                "ic10.format.minEmptyLinesBeforeLabels": {
                    "type": "number",
                    "default": 0,
                    "description": "%ic10.configuration.format.minEmptyLinesBeforeLabels.description%"
                },
                "ic10.format.alignConsecutiveStatements": {
                    "type": "boolean",
                    "default": true,
                    "description": "%ic10.configuration.format.alignConsecutiveStatements.description%"
                },
                "ic10.format.alignTrailingComments": {
                    "type": "boolean",
                    "default": true,
                    "description": "%ic10.configuration.format.alignTrailingComments.description%"
                },
                "ic10.runtime.tickDuration": {
                    "type": "number",
                    "default": 0.5,
                    "description": "%ic10.configuration.runtime.tickDuration.description%"
                },
                "ic10.runtime.maxInstructions": {
                    "type": "integer",
                    "default": 128,
                    "description": "%ic10.configuration.runtime.maxInstructions.description%"
                },
                "ic10.runtime.maxStackSize": {
                    "type": "integer",
                    "default": 512,
                    "description": "%ic10.configuration.runtime.maxStackSize.description%"
                },
                "ic10.runtime.strictEvaluation": {
                    "type": "boolean",
                    "default": true,
                    "description": "%ic10.configuration.runtime.strictEvaluation.description%"
                }
            }
        },
        "configurationDefaults": {
            "[ic10]": {
                "editor.semanticHighlighting.enabled": true
            },
            "editor.semanticTokenColorCustomizations": {
                "rules": {
                    "Keyword": "#CF8E6D",
                    "Register": "#B4654A",
                    "RegisterIdentifier": "#7E4633",
                    "Macro": "#56A8F5",
                    "Device": "#B267D6",
                    "DeviceIdentifier": "#77458F",
                    "Number": "#2AACB8",
                    "NumberIdentifier": "#1F8088",
                    "String": "#6AAB73",
                    "Constant": "#C77DBB",
                    "Comment": "#7A7E85",
                    "Decorator": "#5F826B",
                    "AnnotationTag": "#67A37C",
                    "Label": "#E8BF6A",
                    "Label.declaration": "#E8BF6A",
                    "LabelIdentifier": "#A3874C",
                    "Enum": "#4EC9B0",
                    "EnumMember": "#D9A0DC",
                    "Unknown": "#F75464"
                }
            }
        },
        "semanticTokenTypes": [
            {
                "id": "Keyword",
                "superType": "keyword",
                "description": "%ic10.semanticToken.Keyword.description%"
            },
            {
                "id": "Register",
                "superType": "variable",
                "description": "%ic10.semanticToken.Register.description%"
            },
            {
                "id": "RegisterIdentifier",
                "superType": "variable",
                "description": "%ic10.semanticToken.RegisterIdentifier.description%"
            },
            {
                "id": "Macro",
                "superType": "function",
                "description": "%ic10.semanticToken.Macro.description%"
            },
            {
                "id": "Device",
                "superType": "type",
                "description": "%ic10.semanticToken.Device.description%"
            },
            {
                "id": "DeviceIdentifier",
                "superType": "variable",
                "description": "%ic10.semanticToken.DeviceIdentifier.description%"
            },
            {
                "id": "Number",
                "superType": "number",
                "description": "%ic10.semanticToken.Number.description%"
            },
            {
                "id": "NumberIdentifier",
                "superType": "variable",
                "description": "%ic10.semanticToken.NumberIdentifier.description%"
            },
            {
                "id": "String",
                "superType": "string",
                "description": "%ic10.semanticToken.String.description%"
            },
            {
                "id": "Constant",
                "superType": "variable",
                "description": "%ic10.semanticToken.Constant.description%"
            },
            {
                "id": "Comment",
                "superType": "comment",
                "description": "%ic10.semanticToken.Comment.description%"
            },
            {
                "id": "Decorator",
                "superType": "decorator",
                "description": "%ic10.semanticToken.Decorator.description%"
            },
            {
                "id": "AnnotationTag",
                "superType": "decorator",
                "description": "%ic10.semanticToken.AnnotationTag.description%"
            },
            {
                "id": "Label",
                "superType": "variable",
                "description": "%ic10.semanticToken.Label.description%"
            },
            {
                "id": "LabelIdentifier",
                "superType": "variable",
                "description": "%ic10.semanticToken.LabelIdentifier.description%"
            },
            {
                "id": "Enum",
                "superType": "enum",
                "description": "%ic10.semanticToken.Enum.description%"
            },
            {
                "id": "EnumMember",
                "superType": "enumMember",
                "description": "%ic10.semanticToken.EnumMember.description%"
            },
            {
                "id": "Unknown",
                "superType": "variable",
                "description": "%ic10.semanticToken.Unknown.description%"
            }
        ],
        "semanticTokenColors": {
            "Keyword": "#CF8E6D",
            "Register": "#B4654A",
            "RegisterIdentifier": "#7E4633",
            "Macro": "#56A8F5",
            "Device": "#B267D6",
            "DeviceIdentifier": "#77458F",
            "Number": "#2AACB8",
            "NumberIdentifier": "#1F8088",
            "String": "#6AAB73",
            "Constant": "#C77DBB",
            "Comment": "#7A7E85",
            "Decorator": "#5F826B",
            "AnnotationTag": "#67A37C",
            "Label": "#E8BF6A",
            "LabelIdentifier": "#A3874C",
            "Enum": "#4EC9B0",
            "EnumMember": "#D9A0DC",
            "Unknown": "#F75464"
        },
        "commands": [
            {
                "command": "ic10.completionScope.device",
                "title": "%ic10.command.completionScope.device%"
            },
            {
                "command": "ic10.completionScope.register",
                "title": "%ic10.command.completionScope.register%"
            },
            {
                "command": "ic10.completionScope.number",
                "title": "%ic10.command.completionScope.number%"
            },
            {
                "command": "ic10.completionScope.enum",
                "title": "%ic10.command.completionScope.enum%"
            },
            {
                "command": "ic10.completionScope.identifier",
                "title": "%ic10.command.completionScope.identifier%"
            },
            {
                "command": "ic10.completionScope.keyword",
                "title": "%ic10.command.completionScope.keyword%"
            },
            {
                "command": "ic10.completionScope.all",
                "title": "%ic10.command.completionScope.all%"
            }
        ],
        "keybindings": [
            {
                "command": "ic10.completionScope.device",
                "key": "ctrl+alt+d",
                "when": "editorLangId == ic10 && (editorTextFocus || suggestWidgetVisible)"
            },
            {
                "command": "ic10.completionScope.register",
                "key": "ctrl+alt+r",
                "when": "editorLangId == ic10 && (editorTextFocus || suggestWidgetVisible)"
            },
            {
                "command": "ic10.completionScope.number",
                "key": "ctrl+alt+n",
                "when": "editorLangId == ic10 && (editorTextFocus || suggestWidgetVisible)"
            },
            {
                "command": "ic10.completionScope.enum",
                "key": "ctrl+alt+e",
                "when": "editorLangId == ic10 && (editorTextFocus || suggestWidgetVisible)"
            },
            {
                "command": "ic10.completionScope.identifier",
                "key": "ctrl+alt+i",
                "when": "editorLangId == ic10 && (editorTextFocus || suggestWidgetVisible)"
            },
            {
                "command": "ic10.completionScope.keyword",
                "key": "ctrl+alt+k",
                "when": "editorLangId == ic10 && (editorTextFocus || suggestWidgetVisible)"
            },
            {
                "command": "ic10.completionScope.all",
                "key": "ctrl+alt+0",
                "when": "editorLangId == ic10 && (editorTextFocus || suggestWidgetVisible)"
            }
        ],
        "breakpoints": [
            {
                "language": "ic10"
            }
        ],
        "debuggers": [
            {
                "type": "ic10",
                "label": "IC10 Debug",
                "languages": [
                    "ic10"
                ],
                "runtime": "node",
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "%ic10.debugger.launch.program.description%",
                                "default": "${workspaceFolder}/${command:AskForProgramName}"
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "%ic10.debugger.launch.stopOnEntry.description%",
                                "default": true
                            },
                            "strictEvaluation": {
                                "type": "boolean",
                                "description": "%ic10.debugger.launch.strictEvaluation.description%",
                                "default": true
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "ic10",
                        "request": "launch",
                        "name": "%ic10.debugger.launch.configurationName%",
                        "program": "${file}",
                        "stopOnEntry": true
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "%ic10.debugger.snippet.label%",
                        "description": "%ic10.debugger.snippet.description%",
                        "body": {
                            "type": "ic10",
                            "request": "launch",
                            "name": "%ic10.debugger.snippet.name%",
                            "program": "^\\\"\\\\${workspaceFolder}/\\\\${command:AskForProgramName}\\\"",
                            "stopOnEntry": true
                        }
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile && npm run bundle",
        "compile": "tsc -b",
        "bundle": "node scripts/bundle.mjs",
        "watch": "node scripts/watch.mjs",
        "lint": "eslint",
        "test": "sh ./scripts/e2e.sh"
    },
    "devDependencies": {
        "@types/node": "^26.0.1",
        "esbuild": "^0.28.2",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "verdaccio": "^6.9.2"
    },
    "dependencies": {
        "@ic10/compiler": "^3.2.0",
        "@ic10/runtime": "^2.2.0",
        "@ic10/metadata": "^1.0.0"
    }
}
