{
    "rootDir": "../..",
    "IC10_Compiler_CLI": {
        "BuildDir": "build",
        "SourceDir": ".",
        "Target": "IC10_Compiler_CLI",
        "Config": "Release",
        "TestDir": ".",
        "TestExeDir": "build/bin/Release",
        "TestExeName": {
            "windows": "ic10c.exe",
            "linux": "ic10c"
        }
    },
    "IC10_Compiler_Core": {
        "BuildDir": "build",
        "SourceDir": ".",
        "Target": "IC10_Compiler_Tests",
        "Config": "Release",
        "TestDir": ".",
        "TestExeDir": "build/IC10/backend/compiler/tests/Release",
        "TestExeName": {
            "windows": "IC10_Compiler_Tests.exe",
            "linux": "IC10_Compiler_Tests"
        }
    },
    "IC10_Compiler_Node": {
        "BuildDir": "build",
        "SourceDir": ".",
        "Target": "ic10_compiler_node",
        "Config": "Release",
        "ArtifactPath": "build/IC10/backend/compiler/exports/node/Release/ic10c-node.node",
        "PublishDir":  "IC10/backend/compiler/publish/node/src",
        "TestDir": "IC10/backend/compiler"
    },
    "IC10_Compiler_Python": {
        "BuildDir": "build",
        "SourceDir": ".",
        "Target": "ic10c_python",
        "Config": "Release",
        "ArtifactPath": "build/IC10/backend/compiler/exports/python/Release",
        "ArtifactName": {
            "windows": "ic10c_python.pyd",
            "linux": "ic10c_python.so"
        },
        "PublishDir":  "IC10/backend/compiler/publish/python",
        "TestDir": "IC10/backend/compiler/tests/python"
    },
    "IC10_Compiler_Java": {
        "BuildDir": "build",
        "SourceDir": ".",
        "Target": "ic10_compiler_java",
        "Config": "Release",
        "ArtifactPath": "build/IC10/backend/compiler/exports/java/Release",
        "ArtifactName": {
            "windows": "ic10c_java.dll",
            "linux": "libic10c_java.so"
        },
        "PublishDir":  "IC10/backend/compiler/publish/java/src/main/resources/native",
        "TestDir": "IC10/backend/compiler/tests/java",
        "TestScript": {
            "windows": "gradlew.bat",
            "linux": "gradlew"
        }
    },
    "IC10_Runtime_Node": {
        "BuildDir": "build",
        "SourceDir": ".",
        "Target": "ic10_runtime_node",
        "Config": "Release",
        "ArtifactPath": "build/IC10/backend/runtime/exports/node/Release/ic10r-node.node",
        "PublishDir":  "IC10/backend/runtime/publish/node/src",
        "TestDir": "IC10/backend/runtime"
    }
}